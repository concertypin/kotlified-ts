{
    "name": "kotlified-ts",
    "version": "0.1.0",
    "description": "Compile-time Kotlin extension functions (let/apply/run/also/takeIf/takeUnless) for Vite — zero prototype pollution.",
    "license": "MIT",
    "author": "concertypin",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/concertypin/kotlified-ts.git"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./runtime": {
            "types": "./dist/runtime.d.ts",
            "import": "./dist/runtime.js"
        },
        "./global": {
            "types": "./dist/global.d.ts"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').copyFileSync('src/global.d.ts', 'dist/global.d.ts')\"",
        "test": "node --test",
        "typecheck": "tsc --noEmit",
        "format": "oxfmt --write .",
        "format:check": "oxfmt --check .",
        "lint": "oxlint . --fix",
        "lint:check": "oxlint .",
        "postinstall": "pnpm exec simple-git-hooks",
        "pre-commit": "pnpm run format && pnpm run lint && pnpm run test && git add -u"
    },
    "dependencies": {
        "@babel/generator": "^8.0.0",
        "@babel/parser": "^8.0.4",
        "@babel/types": "^8.0.4"
    },
    "devDependencies": {
        "@concertypin/config": ">=0.3.0 <1.0.0",
        "@types/node": "^26.2.0",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "simple-git-hooks": "^2.13.1",
        "typescript": "^7.0.2",
        "vite": "^8.2.1"
    },
    "peerDependencies": {
        "vite": ">=5.0.0"
    },
    "engines": {
        "node": ">=22.18.0 <23.0.0 || >=23.6.0"
    },
    "packageManager": "pnpm@11.17.0"
}
